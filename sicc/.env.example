# SICC environment template. Copy to .env.local for local development.
# Never commit .env.local or real credentials.

# Application
APP_URL=http://localhost:3000

# Current Worker bootstrap (server-only). Set these in the deployment secret store.
SICC_ADMIN_EMAIL=
SICC_BOOTSTRAP_KEY=
# Safety switch: leave false/empty until billing and R2 limits are reviewed.
SICC_STORAGE_WRITE_ENABLED=false

# Supabase target (publishable key may be used by a browser client; service role is server/Edge only).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sicc-private

# Cloudflare R2 (server/Worker/Pages Function only; never expose the secret key)
R2_BUCKET_NAME=sicc-private
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# The beta currently computes face descriptors locally with face-api.js.
# The Supabase target should move matching to a server/Edge Function.
FACE_MATCH_PROVIDER=local_face_embedding
FACE_MATCH_ENDPOINT=
