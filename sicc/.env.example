# SICC — variáveis de ambiente
# Copie para .env.local apenas no desenvolvimento. Nunca coloque valores reais
# neste arquivo nem no GitHub.

# Frontend estático (Vite/GitHub Pages)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# A chave anon/publishable é pública por desenho e fica limitada por RLS.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL pública da Edge Function, sem barra final.
VITE_SICC_API_URL=https://SEU-PROJETO.supabase.co/functions/v1/sicc-api

# Edge Function (somente Supabase secrets; nunca expor no navegador)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SICC_STORAGE_BUCKET=sicc-media
SICC_ALLOWED_ORIGIN=https://4quarenta.github.io
# Necessária apenas para ativar a primeira conta administradora.
SICC_BOOTSTRAP_KEY=

# OneSignal (a App ID é pública e fica no frontend; a REST API key é secreta)
ONESIGNAL_APP_ID=6934d3ea-0e2f-4273-8196-6415d4933815
ONESIGNAL_REST_API_KEY=
SICC_WEB_APP_URL=https://4quarenta.github.io/SICC/
