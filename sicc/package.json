{
  "name": "sicc-beta",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.pages.config.ts",
    "build": "vite build --config vite.pages.config.ts",
    "build:pages": "vite build --config vite.pages.config.ts",
    "preview": "vite preview --config vite.pages.config.ts",
    "typecheck": "tsc --noEmit",
    "supabase:function:serve": "supabase functions serve sicc-api --no-verify-jwt",
    "supabase:function:deploy": "supabase functions deploy sicc-api",
    "test:parser": "node --experimental-strip-types tests/infoseg-parser.test.ts",
    "test:importador": "node tools/importador-legado/rules.test.mjs && node tools/importador-legado/caption-ocr.test.mjs && node tools/importador-legado/multi-person.test.mjs",
    "test:compressao": "node --test tools/importador-legado/comprimir-imagens.test.mjs",
    "test:revisao": "node --test tools/importador-legado/revisar-dados.test.mjs tools/importador-legado/aprofundar-revisao.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "@vladmandic/face-api": "^1.7.15",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "displayName": "SICC Beta"
}
